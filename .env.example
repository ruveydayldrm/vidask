# ---------------------------------------------------------------------------
# VidAsk configuration. Copy to `.env` and adjust. Every model is swappable here.
# ---------------------------------------------------------------------------

# --- Hardware --------------------------------------------------------------
# auto: use CUDA only if the GPU has >= MIN_GPU_VRAM_GB, otherwise CPU
DEVICE=auto
MIN_GPU_VRAM_GB=4

# --- LLM -------------------------------------------------------------------
# ollama (default, local) | groq | gemini
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# Context window requested from Ollama (num_ctx). Bigger = more RAM, slower on CPU.
LLM_CONTEXT_WINDOW=8192
OLLAMA_BASE_URL=http://localhost:11434

# Optional free-tier hosted providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Transcription (only used when a video has no captions) -----------------
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=auto

# --- Retrieval ---------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true
CHUNK_SECONDS=45
CHUNK_OVERLAP_SECONDS=10
RETRIEVAL_TOP_K=6
# auto | full | rag  (auto: full transcript if it fits FULL_CONTEXT_RATIO of the window)
CONTEXT_STRATEGY=auto
FULL_CONTEXT_RATIO=0.55

# --- Infrastructure ----------------------------------------------------------
# Empty QDRANT_URL -> embedded Qdrant under ./data/qdrant
QDRANT_URL=
# Empty REDIS_URL -> jobs run in a background thread inside the API
REDIS_URL=

# --- Visual understanding ----------------------------------------------------
VISION_ENABLED=false
VISION_MAX_FRAMES=40
# e.g. qwen2.5vl:3b (pull it in Ollama first); empty = OCR only
VISION_VLM_MODEL=

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
